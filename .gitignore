# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/

# Data, checkpoints, HF cache (heavy, not versioned)
data/
checkpoints/
.hf_cache/

# Experiment outputs (versioned selectively, not by default).
# Ignore contents (experiments/*), not the dir itself, so a nested file can
# be re-included: git cannot un-ignore a file under a fully-excluded dir.
experiments/*
# ...except the Phase 2 pre-registration and the small results summary
# (the heavy .pt substrates stay ignored)
!experiments/phase2_pilot/
experiments/phase2_pilot/*
!experiments/phase2_pilot/PREREG.md
!experiments/phase2_pilot/analysis.json
!experiments/phase2_pilot/fid_decomp.json
!experiments/phase3_main/
experiments/phase3_main/*
!experiments/phase3_main/PREREG.md
!experiments/phase3_main/analysis.json
!experiments/phase3_main/hook_fidelity.json

# Noisy run logs from scripts/notebooks (PNG + summary.json are versioned)
notebooks/out/*.log

# Papers (locali, non distribuibili, note di lettura personali)
papers/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Weights & Biases
wandb/

# ROCm / HIP cache
__hip_rtc_temp/

# Personal planning docs (not versioned)
PROJECT_PLAN.md
docs/phase*_plan.md
papers

# Misc
*.swp
*.swo
*~
.env
*.pdf
guides/
*.pptx

# Paper (versioned): the compiled PDF, its figures, and the small JSON
# artifacts every number in the paper is traced to (see paper/AUDIT.md)
!paper/main.pdf
!paper/figures/*.pdf
!experiments/phase3_main/detector.json
!experiments/phase3_main/fid_multispace.json
!experiments/phase3_main/figures/
experiments/phase3_main/figures/*
!experiments/phase3_main/figures/f2_profiles.json
!experiments/phase3_main/figures/benign_layer_levels.json
!experiments/energy_probe/
experiments/energy_probe/*
!experiments/energy_probe/energy_analysis.json
!experiments/phase4_heun/
experiments/phase4_heun/*
!experiments/phase4_heun/analysis.json
!experiments/weight_norm_comparison.json

# Paper: working documents and raster duplicates stay local
paper/PLAN.md
paper/AUDIT.md
paper/figures/*.png
paper/*.bbl

# Phase 5 (post-thesis): design notes and small JSON outputs only
!experiments/phase5_cfg/
experiments/phase5_cfg/*
!experiments/phase5_cfg/DESIGN.md
!experiments/phase5_cfg/analysis.json
!experiments/phase5_pretrained/
experiments/phase5_pretrained/*
!experiments/phase5_pretrained/DESIGN.md
!experiments/phase5_pretrained/analysis.json
